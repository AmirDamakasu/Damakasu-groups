# ============================================================
# Environment Variables — copy this file to .env and fill in real values
# ⚠️  NEVER commit your real .env file or paste real keys here.
# ============================================================

# Supabase — get from: Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# ⚠️  PLACEHOLDER only — paste your own anon key from the Supabase dashboard
VITE_SUPABASE_ANON_KEY=eyJ...YOUR_SUPABASE_ANON_KEY_HERE

# Google reCAPTCHA v3 — get from https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_SITE_KEY

# Admin Dashboard Password (SHA-256 hash — never store plain-text here)
# To generate your own hash, open the browser console and run:
#   const h = await crypto.subtle.digest('SHA-256', new TextEncoder().encode('yourpassword'));
#   console.log([...new Uint8Array(h)].map(b=>b.toString(16).padStart(2,'0')).join(''));
# ⚠️  Replace this with YOUR OWN hash — do not use the example hash in production
VITE_ADMIN_PASSWORD_HASH=REPLACE_WITH_YOUR_OWN_SHA256_HASH

# Admin session HMAC secret — random 32+ char string, used to sign admin session tokens
# Generate with: openssl rand -hex 32
VITE_ADMIN_SESSION_SECRET=REPLACE_WITH_RANDOM_32_CHAR_SECRET

# ============================================================
# Supabase Edge Function Secrets
# Set these in: Supabase Dashboard > Project Settings > Edge Functions > Secrets
# Do NOT set VITE_ prefixed copies of these — they must NEVER reach the browser
# ============================================================
# RESEND_API_KEY=re_YOUR_RESEND_API_KEY
# RECAPTCHA_SECRET_KEY=YOUR_RECAPTCHA_SECRET_KEY
# COMPANY_EMAIL=damakasumultilinkinvestmentlimited@gmail.com
# ADMIN_SESSION_SECRET=REPLACE_WITH_RANDOM_32_CHAR_SECRET  (same value as above)
