# =============================================================
# Environment Variables — copy this file to .env and fill in real values
# ⚠️  NEVER commit your real .env file or paste real keys here.
# =============================================================

# Supabase — Dashboard > Project Settings > API
# Only the project URL and the anon / publishable key belong here: both are designed to be public,
# and Row Level Security (supabase/schema.sql) controls what they can access.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Google reCAPTCHA v3 site key — https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=

# Admin dashboard sign-in uses Supabase Auth accounts listed in public.admin_users
# (see supabase/schema.sql). No admin password or hash belongs in this file.

# =============================================================
# Supabase Edge Function Secrets — NOT for this file.
# Set in: Supabase Dashboard > Edge Functions > Secrets (or `npx supabase secrets set`).
# Never create VITE_ copies of these: VITE_ variables are published in the website code.
# =============================================================
# RESEND_API_KEY=
# RESEND_FROM=Damakasu Multi-Link <noreply@damakasu.com>
# RECAPTCHA_SECRET_KEY=
# COMPANY_EMAIL=info@damakasu.com
# ALLOWED_ORIGINS=https://damakasu.com,https://www.damakasu.com
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to Edge Functions automatically.)
