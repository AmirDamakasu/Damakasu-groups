Options -MultiViews -Indexes
DirectoryIndex index.html

# Never serve server configuration files.
<FilesMatch "^\.ht">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Preferred domain: www.damakasu.com -> https://damakasu.com.
  # (HTTP -> HTTPS is handled by Hostinger's "Force HTTPS" setting, so it is not repeated here.)
  RewriteCond %{HTTP_HOST} ^www\.damakasu\.com$ [NC]
  RewriteRule ^(.*)$ https://damakasu.com/$1 [R=301,L]

  # Prerendered pages are stored as page.html; send direct requests for the .html file to the clean URL.
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+([a-z0-9-]+)--([a-z0-9-]+)\.html[\s?] [NC]
  RewriteRule ^ /%1/%2 [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
  RewriteCond %1 !^404$
  RewriteRule ^ /%1 [R=301,L]

  # One URL per page: drop trailing slashes (except on the homepage).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Clean URLs: /about -> about.html, /products/soybeans -> products--soybeans.html.
  # (A missing file falls through to the 404 page.)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([a-z0-9-]+)$ $1.html [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-z0-9-]+)/([a-z0-9-]+)$ $1--$2.html [L]
</IfModule>

# Unknown URLs get a real 404 status with the site's 404 page.
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Hostinger CDN's HTTP/3 (QUIC) stalls for this site: pages hang or time out over h3 while the
  # same pages load in 1-3 s over HTTP/2 (measured 15 Oct 2026). Tell browsers not to switch to h3.
  # Note: while Hostinger CDN is on, it overrides this and still sends h3; disable the CDN in hPanel.
  Header always unset Alt-Svc
  Header always set Alt-Svc "clear"
  # Browsers must use HTTPS for this site for a year (add includeSubDomains only once every
  # subdomain serves HTTPS).
  Header always set Strict-Transport-Security "max-age=31536000"
  # Content Security Policy — keep in sync with the <meta> copy in index.html.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://www.google.com https://www.gstatic.com; connect-src 'self' https://*.supabase.co https://www.google.com; frame-src https://www.google.com https://recaptcha.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"

  <FilesMatch "^(admin|404)\.html$">
    Header set X-Robots-Tag "noindex, follow"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml application/xml text/xml text/plain
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
  # Hashed files in /assets/ get a year (and "immutable") from assets/.htaccess. These type rules
  # cover everything else; /images/ files keep their names when replaced, so they get a month.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
