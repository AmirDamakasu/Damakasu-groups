Options -MultiViews -Indexes
DirectoryIndex index.html

# Never serve server configuration files.
<FilesMatch "^\.ht">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Preferred domain: www.damakasu.com -> https://damakasu.com.
  # (HTTP -> HTTPS is handled by Hostinger's "Force HTTPS" setting, so it is not repeated here.)
  RewriteCond %{HTTP_HOST} ^www\.damakasu\.com$ [NC]
  RewriteRule ^(.*)$ https://damakasu.com/$1 [R=301,L]

  # Prerendered pages are stored as page.html; send direct requests for the .html file to the clean URL.
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+([a-z0-9-]+)--([a-z0-9-]+)\.html[\s?] [NC]
  RewriteRule ^ /%1/%2 [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
  RewriteCond %1 !^404$
  RewriteRule ^ /%1 [R=301,L]

  # One URL per page: drop trailing slashes (except on the homepage).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Clean URLs: /about -> about.html, /products/soybeans -> products--soybeans.html.
  # (A missing file falls through to the 404 page.)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([a-z0-9-]+)$ $1.html [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-z0-9-]+)/([a-z0-9-]+)$ $1--$2.html [L]
</IfModule>

# Unknown URLs get a real 404 status with the site's 404 page.
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  <FilesMatch "^(admin|404)\.html$">
    Header set X-Robots-Tag "noindex, follow"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml application/xml text/xml text/plain
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
  # Files in /assets/ have content hashes in their names, so they can be cached for a year.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
